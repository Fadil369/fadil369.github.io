# Shopify Customer Account API (public client) — required at build time.
#
# Client ID from: Shopify admin → Settings → Customer accounts → Customer
# Account API. Keep in sync with the "Application setup" URIs registered
# there (callback / JS origins / logout). Copy to `.env` and rebuild.
VITE_CUSTOMER_ACCOUNT_CLIENT_ID=4721f12f-88be-466a-892f-80f005a3cff7

# Storefront domain used for OIDC + Customer Account API discovery.
# Shopify returns account-domain endpoints from here. Defaults to
# https://account.brainsait.org if unset.
VITE_CUSTOMER_ACCOUNT_DOMAIN=https://store.brainsait.de

# Existing BrainSAIT orchestration endpoints. Keep credentials server-side.
VITE_BUILD_APPLY_API=https://build-apply.brainsait.org
VITE_JOURNEY_EVENTS_API=https://build-apply.brainsait.org/webhook/forge/event
