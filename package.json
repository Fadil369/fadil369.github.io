{
  "name": "brainsait-store",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Dr. Mohamed El Fadil and the BrainSAIT Provider Registry — bilingual professional profile and BPR hub",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test --experimental-strip-types src/utils/*.test.ts",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "verify:design": "node scripts/verify-design.mjs",
    "sync:store": "python3 scripts/sync-catalog-from-woocommerce.py && bash scripts/verify-catalog-provenance.sh",
    "verify:catalog": "bash scripts/verify-catalog-provenance.sh",
    "deploy": "npm run build && node scripts/publish.mjs",
    "sync:shopify": "python3 scripts/sync-catalog-from-shopify.py --write",
    "sync:shopify:dry": "python3 scripts/sync-catalog-from-shopify.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsqr": "^1.4.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
