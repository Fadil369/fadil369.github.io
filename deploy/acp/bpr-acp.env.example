# Copy to /etc/bpr-acp.env (root:root, mode 600). Never commit real values.
ACP_PUBLIC_URL=https://acp.brainsait.de
ACP_PORT=8787
# GitHub OAuth App (callback: https://acp.brainsait.de/callback)
ACP_GITHUB_CLIENT_ID=
ACP_GITHUB_CLIENT_SECRET=
# Comma-separated NUMERIC GitHub user IDs allowed to sign in (find one with: gh api user --jq .id)
ACP_ALLOWED_GITHUB_IDS=
# Max prompts per signed-in user per hour (1-1000, default 20)
ACP_RATE_PER_HOUR=20
# Dedicated agent home: keeps operator skills, plugins, MCP servers, hooks and instructions out of the agent.
ACP_AGENT_HOME=/var/lib/bpr-acp/agent-home
# Fine-grained token with the "Copilot Requests" permission, from the account whose Copilot entitlement is used.
COPILOT_GITHUB_TOKEN=
